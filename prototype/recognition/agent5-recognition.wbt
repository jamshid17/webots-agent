#VRML_SIM R2025a utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/softbank/nao/protos/Nao.proto"
WorldInfo { basicTimeStep 32 }
Viewpoint { orientation -0.3 0.3 0.9 2.3 position 2 2 1.5 }
Background { skyColor [ 0.65 0.75 0.9 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 }
Solid {
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.7 roughness 1 metalness 0 } geometry Box { size 10 10 0.1 } } ]
  boundingObject Box { size 10 10 0.1 }
}
Nao {
  name "Jame"
  translation 0 0 0.334
  controller "my_controller_plus_mcp"
  cameraWidth 320
  cameraHeight 240
  headSlot [
    Camera {
      translation 0.0587 0 0.0636
      rotation 0 1 0 0.0209
      name "RecognitionCamera"
      width 320
      height 240
      fieldOfView 1.064
      recognition Recognition { maxRange 5 occlusion 2 }
    }
  ]
}
Solid {
  translation 1.2 0.15 0.25
  name "red box"
  model "red box"
  recognitionColors [ 1 0 0 ]
  children [ Shape { appearance PBRAppearance { baseColor 0.9 0.05 0.05 roughness 0.8 metalness 0 } geometry Box { size 0.25 0.25 0.5 } } ]
  boundingObject Box { size 0.25 0.25 0.5 }
  physics Physics { mass 0.5 density -1 }
}
Solid {
  translation 1.4 -0.45 0.3
  name "blue box"
  model "blue box"
  recognitionColors [ 0 0 1 ]
  children [ Shape { appearance PBRAppearance { baseColor 0.05 0.05 0.9 roughness 0.8 metalness 0 } geometry Box { size 0.2 0.2 0.6 } } ]
  boundingObject Box { size 0.2 0.2 0.6 }
  physics Physics { mass 0.5 density -1 }
}
Solid {
  translation 0.8 1.3 0.35
  name "green box"
  model "green box"
